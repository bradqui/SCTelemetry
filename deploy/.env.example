# Copy to .env (next to docker-compose.yml) and fill in. Never commit .env.

# The public address members use. Discord's OAuth redirect is <HUB_URL>/auth/callback.
HUB_URL=https://fleet.fridaynightclub.xyz

# Discord application (discord.com/developers > your app > OAuth2).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Right-click the server / role in Discord (Developer Mode on) > Copy ID.
DISCORD_GUILD_ID=
# Who may sign in and link a PC. Leave empty to allow everyone in the server.
DISCORD_MEMBER_ROLE_ID=

# Shared with the ButlerBot cog for the internal API (port 8101). Make one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
HUB_INTERNAL_SECRET=

# Optional
# HUB_LOG_LEVEL=INFO
