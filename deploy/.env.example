# Copy to .env (next to docker-compose.yml) and fill in. Never commit .env.

# The public address of your hub, with https. Invite links and sign-in use it.
HUB_URL=https://fleet.example.org

# Your org's name on the sign-in page and header (admins can change it later).
HUB_ORG_NAME=My Org

# How long the fleet's event history is kept.
# HUB_EVENT_RETENTION_DAYS=30

# How long problem reports members send to the admins are kept.
# HUB_REPORT_RETENTION_DAYS=30

# --- Optional: "Sign in with Discord" -------------------------------------------
# Easiest: leave these empty and set Discord up on the page (Admin → Settings →
# Discord), which shows the same steps. Anything set here is only a default.
# Without Discord, members join with invite links.
# With it, members can connect Discord and sign in with it, and admins can
# let holders of a Discord role join without an invite (Admin → Settings).
# Discord app: discord.com/developers → New Application → OAuth2 → add the redirect
#   <HUB_URL>/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Right-click your server / role in Discord (Developer Mode on) → Copy ID.
DISCORD_GUILD_ID=
# Members who connected Discord are suspended if they lose this role. Empty: anyone in the server.
DISCORD_MEMBER_ROLE_ID=

# --- Optional: running this hub for another org ----------------------------------
# If you host this hub for an org (they don't run it themselves), name yourself here: the
# sign-in and join pages then say "Hosted by <name>", and the org's admins get
# Admin → Settings → Close this org, which records a request for you (spec decision 28).
# HUB_HOST_NAME=Example Hosting
# Your page about hosted orgs (privacy, terms), linked beside the name.
# HUB_HOST_URL=https://hosting.example.org/privacy

# HUB_LOG_LEVEL=INFO

# Which released hub image to run (docker compose pull). Default: latest.
# HUB_VERSION=0.2.0
